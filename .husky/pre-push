#!/bin/sh

PUSH_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null)

# Check for spec staleness
if echo "$PUSH_FILES" | grep -qE "^(src/|server/|tests/)"; then
  if echo "$PUSH_FILES" | grep -qE "openspec/specs/.*/spec\.md"; then
    echo "Spec file updated."
  else
    echo ""
    echo "⚠️  Warning: Source/test files changed but openspec/specs/study/spec.md was NOT updated."
    echo "   Please review whether the spec needs updating before pushing."
    echo ""
  fi
fi

# Run full test suite
echo "Running full test suite..."
pnpm run test:all
TEST_EXIT_CODE=$?
if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "Tests failed with code $TEST_EXIT_CODE"
  exit $TEST_EXIT_CODE
fi
echo "Tests passed!"

exit 0
